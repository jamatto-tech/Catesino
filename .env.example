# Catesino environment template — no secrets. Copy to .env and fill values.

# Cluster: mainnet-beta | devnet
SOLANA_CLUSTER=devnet

# Mints (defaults match design freezes when unset — set explicitly in deploy)
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
CATE_MINT=Ai66LHZG9MCzg1WKdawwqduVAXpNDUuV8M3uyq5ppump

# Bets (USDC human units; ledger uses 6-decimal atomic internally)
BET_MIN_USDC=0.5
BET_MAX_USDC=25

# Daily $CATE buy policy
BUY_RATIO=0.7
RESERVE_FLOOR_USDC=5000
MIN_DAILY_BUY_USDC=25
MAX_DAILY_BUY_USDC=10000

# Compliance
AGE_MINIMUM=18
GEO_DENY_LIST=US-UNSET
# Comma-separated ISO country codes to hard-block (counsel-owned list)
# GEO_DENY_LIST=KP,IR

# Feature flags
FF_MARKETING_THESIS_CLAIMS=false
# Counsel gate: never enable on public mainnet until checklist signed
FF_PUBLIC_MAINNET_FUNDS=false
# Real custody paths — keep false until deposit claim + withdraw-hot are wired
FF_DEPOSITS_USDC=false
FF_WITHDRAWALS=false
FF_BLACKJACK_ENABLED=true

# Cate Machine (gacha). A on; holder / paid / NFT stay off until later PRs.
FF_GACHA_ENABLED=true
FF_GACHA_CATE_HOLDER_PULL=false
FF_GACHA_PAID_PULLS=false
FF_GACHA_NFT_PRIZES=false
CATE_DECIMALS=6
CATE_HOLDER_MIN=100000
GACHA_PAID_PULL_USDC=2
GACHA_PITY_RARE_HARD=100
GACHA_YARN_FAUCET_DAILY=1
GACHA_YARN_START=5
GACHA_YARN_CAP=20
# Optional dedicated locker HMAC secret (falls back to SESSION_SECRET)
# GACHA_COOKIE_SECRET=

# Custody (never put private keys here — public addresses / policy only)
# DEPOSIT_OWNER_PUBKEY=
# DEPOSIT_ATA=
MIN_DEPOSIT_USDC=1
MIN_CONFIRMATIONS=32
SECONDARY_RPC_THRESHOLD_USDC=50
WITHDRAW_FIRST_COOLDOWN_HOURS=24
WITHDRAW_COOLDOWN_MINUTES=0
WITHDRAW_MANUAL_THRESHOLD_USDC=100
WITHDRAW_DUAL_APPROVE_THRESHOLD_USDC=500
WITHDRAW_HOT_PER_TX_CAP_USDC=200
WITHDRAW_HOT_DAILY_CAP_USDC=5000
WITHDRAW_HOT_MAX_BALANCE_USDC=2000

# Auth (SIWS) — real wallet sessions only; demo needs none of this
CATESINO_AUTH_DOMAIN=localhost
# Required strong secret in production
SESSION_SECRET=dev-only-change-me-catesino-session

# Solana RPC (deposit claim / hot balance). Never put private keys here.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL_SECONDARY=
# WITHDRAW_HOT_USDC_ATA=

# Optional runtime
NODE_ENV=development
PORT=3000
WORKER_PORT=3100
