{
  "name": "catesino",
  "private": true,
  "version": "0.1.0",
  "description": "Catesino — community-driven casino for $CATE",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter @catesino/web run build && pnpm --filter @catesino/worker run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter=./packages/* run test",
    "test:blackjack": "pnpm --filter @catesino/blackjack test",
    "test:ledger": "pnpm --filter @catesino/ledger test",
    "dev:web": "pnpm --filter @catesino/web dev",
    "dev:worker": "pnpm --filter @catesino/worker start",
    "lint": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1"
  }
}
